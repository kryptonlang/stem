{
  "title": "STEM",
  "title_includes_cwd": true,
  "app_id": "stem",
  "cols": 120,
  "rows": 32,
  "padding": 10,
  "opacity": 0.95,
  "decorations": true,
  "confirm_close": false,
  "shell": "",
  "working_directory": "~",
  "term": "xterm-256color",
  "login_shell": false,
  "shell_integration": true,
  "command_history": true,
  "history_file": "~/.config/stem/history",
  "history_max_entries": 10000,
  "restore_session": true,
  "session_file": "~/.config/stem/session.conf",
  "font_family": "MesloLGS Nerd Font, JetBrainsMono Nerd Font, monospace",
  "font_size": 13.5,
  "line_spacing": 0,
  "cursor_style": "bar",
  "cursor_blink_ms": 530,
  "cursor_color": "#8B5CF6",
  "selection_background": "#3A2A60",
  "copy_on_select": false,
  "osc52_clipboard": "ask",
  "bell": "visual",
  "scrollback": 10000,
  "scroll_multiplier": 3,
  "bind.copy": "ctrl+shift+c",
  "bind.paste": "ctrl+shift+v",
  "bind.reload_config": "ctrl+shift+r",
  "bind.command_palette": "ctrl+shift+p",
  "bind.command_history": "ctrl+shift+h",
  "bind.new_window": "ctrl+shift+n",
  "bind.close_window": "ctrl+shift+w",
  "plugins_enabled": true,
  "plugin_dir": "~/.config/stem/plugins",
  "plugin_event_format": "text",
  "control_enabled": true,
  "control_file": "~/.config/stem/ctl",
  "hyprland_ipc": true,
  "renderer": "cpu",
  "debug_overlay": false,
  "fps_overlay": false,
  "perf_log": false,
  "hyperlinks": true,
  "kitty_keyboard": false,
  "synchronized_output": true,
  "background": "#05070C",
  "foreground": "#D8DAD4",
  "accent": "#8B5CF6",
  "color0": "#1E1E1E",
  "color1": "#F14C4C",
  "color2": "#23D18B",
  "color3": "#F5F543",
  "color4": "#3B8EEA",
  "color5": "#D670D6",
  "color6": "#29B8DB",
  "color7": "#E5E5E5",
  "color8": "#666666",
  "color9": "#F14C4C",
  "color10": "#23D18B",
  "color11": "#F5F543",
  "color12": "#3B8EEA",
  "color13": "#D670D6",
  "color14": "#29B8DB",
  "color15": "#FFFFFF",
  "padding_x": 10,
  "padding_y": 10,
  "initial_command": "",
  "mouse_hide_while_typing": true,
  "search_wrap": true,
  "search_case_sensitive": false,
  "max_fps": 120,
  "vsync": true,
  "grapheme_clusters": true,
  "ligatures_enabled": false,
  "font_fallback": true,
  "bind.split_equalize": "ctrl+shift+equal",
  "bind.split_grow": "ctrl+shift+period",
  "bind.split_shrink": "ctrl+shift+comma",
  "bind.swap_panes": "ctrl+shift+s",
  "bind.toggle_fullscreen": "f11",
  "bind.open_config": "ctrl+shift+i",
  "selection_foreground": "",
  "link_color": "#87afff",
  "bind.jump_to_prompt": "ctrl+shift+up",
  "clipboard_read": "allow",
  "clipboard_write": "allow"
}
